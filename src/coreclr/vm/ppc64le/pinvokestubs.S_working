#include "unixasmmacros.inc"
#include "asmconstants.h"

//
// in:
// PINVOKE_CALLI_TARGET_REGISTER   (r0)  = unmanaged target
//   Note: genCallInstruction emits "mr r0, r12" before loading the helper address
//   into r12 for the indirect call.  r12 holds the target after genCallPlaceRegArgs
//   (REG_PINVOKE_TARGET_PARAM == REG_R12), but the 5-instruction address-materialisation
//   sequence overwrites r12 with GenericPInvokeCalliHelper's address.  Saving to r0
//   first preserves the unmanaged target.  r0 is valid as an ALU source on PPC64LE.
// PINVOKE_CALLI_SIGTOKEN_REGISTER (r11) = VASigCookie*  [REG_PINVOKE_COOKIE_PARAM]
//
// out:
// REG_SECRET_STUB_PARAM           (r11) = (unmanaged_target << 1) | 1
//                                         (encoded so the IL stub can recover it via SHR 1)
//
LEAF_ENTRY GenericPInvokeCalliHelper, _TEXT
    ld      %r12, OFFSETOF__VASigCookie__pNDirectILStub(%r11)
    cmpdi   %r12, 0
    bne     0f

    // pNDirectILStub == NULL: need to call GenericPInvokeCalliGenILStub to create the stub.
    //
    // GenericPInvokeCalliHelper is a LEAF_ENTRY — it has NO GEP prolog, so r2 is
    // still the JIT caller's TOC when we reach here.  Before jumping to the body of
    // GenericPInvokeCalliGenILStub we MUST establish r2 = libcoreclr TOC, otherwise
    // bl GenericPInvokeCalliStubWorker and its PLT callees will use the wrong TOC.
    //
    // We use bcl to capture the PC into r12, then compute both:
    //   (a) r2  = libcoreclr TOC  via (.TOC. - .LgetPC)@ha/lo
    //   (b) CTR = &.LGenericPInvokeCalliGenILStubBody  via PC-relative offset
    // We also save/restore lr (bcl clobbers it) via r12 + red zone (-8(r1)).
    //
    // Register discipline:
    //   r0  = unmanaged target — never touched below ✓
    //   r11 = VASigCookie*    — never touched below ✓
    //   r12 = scratch (volatile, non-arg) — used for lr save and PC-relative computes
    //   r2  = set to libcoreclr TOC before bctr ✓
    //   lr  = restored from red zone before bctr ✓
    mflr    %r12                   // r12 = real lr
    std     %r12, -8(%r1)          // red zone: save lr (LEAF, pre-stdu — valid in ELFv2)
    bcl     20, 31, .LgetPC        // lr = &.LgetPC  (clobbers lr)
.LgetPC:
    mflr    %r12                   // r12 = &.LgetPC (= current PC in libcoreclr DSO)
    // Establish libcoreclr TOC from the known PC:
    addis   %r2, %r12, (.TOC. - .LgetPC)@ha
    addi    %r2, %r2,  (.TOC. - .LgetPC)@l   // r2 = libcoreclr TOC ✓
    // Compute address of .LGenericPInvokeCalliGenILStubBody (skip GEP prolog):
    addis   %r12, %r12, (.LGenericPInvokeCalliGenILStubBody - .LgetPC)@ha
    addi    %r12, %r12, (.LGenericPInvokeCalliGenILStubBody - .LgetPC)@l
    mtctr   %r12                   // CTR = &.LGenericPInvokeCalliGenILStubBody
    ld      %r12, -8(%r1)          // r12 = real lr  (r12 reused; CTR already set)
    mtlr    %r12                   // lr  = real return address ✓
    bctr                           // → .LGenericPInvokeCalliGenILStubBody
                                   // r0=target, r11=cookie, r2=libcoreclr_TOC ✓, lr=real lr ✓
0:
    // pNDirectILStub != NULL: tail-call into the JIT-generated IL stub.
    //
    // The IL stub is a NESTED_ENTRY with an ELFv2 global-entry-point (GEP) prolog:
    //   std  r2, 24(r1)
    //   addis r2, r12, (.TOC.-ILStub)@ha
    //   addi  r2, r2,  (.TOC.-ILStub)@l
    // so r12 MUST equal the IL stub's entry address (== CTR) when we branch.
    //
    // The IL stub reads the unmanaged target via StubHelpers.GetStubContext(), which
    // is a JIT intrinsic that returns lvaStubArgumentVar.  lvaStubArgumentVar is
    // initialised from REG_SECRET_STUB_PARAM = r11 in the IL stub's prolog.  The
    // encoding is (unmanaged_target << 1)|1; the IL stub recovers it with SHR 1.
    //
    // r0  = unmanaged_target  (from caller via genCallInstruction "mr r0, r12")
    // r11 = VASigCookie*      (REG_PINVOKE_COOKIE_PARAM)
    // r12 = pNDirectILStub    (loaded above, non-zero)
    //
    // Steps:
    //   1. Encode unmanaged_target (r0) into r11.
    //   2. Copy r12 (IL stub address) into CTR so the GEP prolog works (r12 already set).
    sldi    %r11, %r0, 1           // r11 = unmanaged_target << 1
    ori     %r11, %r11, 1          // r11 = (unmanaged_target << 1) | 1  (secret arg)
    mtctr   %r12                   // CTR = pNDirectILStub (r12 already = pNDirectILStub)
    bctr                           // IL stub GEP: addis r2, r12, ...@ha works correctly ✓
LEAF_END GenericPInvokeCalliHelper, _TEXT

// GenericPInvokeCalliGenILStub
//
// Entry points:
//
// 1. GenericPInvokeCalliGenILStub (GEP — external / via function pointer)
//    Requires r12 == GEP address per ELFv2.  Runs the standard two-instruction
//    TOC prolog to establish r2, then branches to the body.
//
// 2. .LGenericPInvokeCalliGenILStubBody (cold-path entry from GenericPInvokeCalliHelper)
//    GenericPInvokeCalliHelper jumps here directly (past the GEP prolog) via bctr.
//    r2 is already = libcoreclr TOC (set by GenericPInvokeCalliHelper's own GEP).
//    r0  = unmanaged target (intact), r11 = VASigCookie* (intact), lr = return addr.
//
NESTED_ENTRY GenericPInvokeCalliGenILStub, _TEXT, NoHandler
    // Standard ELFv2 GEP: sets r2 using r12 == GEP address.
    std     %r2, 24(%r1)
    addis   %r2, %r12, (.TOC.-GenericPInvokeCalliGenILStub)@ha
    addi    %r2, %r2, (.TOC.-GenericPInvokeCalliGenILStub)@l
.LGenericPInvokeCalliGenILStubBody:
    // Pin the unmanaged target (r0) into r15 immediately so that r0 is free
    // to be used for the standard ELFv2 LR save pattern below.
    mr  %r15, %r0                  // r15 = unmanaged target (callee-saved, preserved across bl)
    mflr %r0                       // r0  = real lr  (standard ELFv2: use r0 for LR save)
    std %r0, 16(%r1)               // save lr into caller's linkage area
    std %r31, -8(%r1)
    stdu %r1, -496(%r1)
    std %r2, 24(%r1)               // save TOC in new frame for post-bl ld r2,24(r1) restore
    .cfi_def_cfa_offset 496
    .cfi_offset 65, 16
    .cfi_offset 31, -8
    mr %r31, %r1
    .cfi_def_cfa_register 31

    // Store GPR r3 to r10 and r14 to r31 (base from stack pointer r1)
    std %r3, 32(%r1)
    std %r4, 40(%r1)
    std %r5, 48(%r1)
    std %r6, 56(%r1)
    std %r7, 64(%r1)
    std %r8, 72(%r1)
    std %r9, 80(%r1)
    std %r10, 88(%r1)

    stfd %f1, 96(%r1)
    stfd %f2, 104(%r1)
    stfd %f3, 112(%r1)
    stfd %f4, 120(%r1)
    stfd %f5, 128(%r1)
    stfd %f6, 136(%r1)
    stfd %f7, 144(%r1)
    stfd %f8, 152(%r1)
    stfd %f9, 160(%r1)
    stfd %f10, 168(%r1)
    stfd %f11, 176(%r1)
    stfd %f12, 184(%r1)
    stfd %f13, 192(%r1)

    std %r14, 200(%r1)
    std %r15, 208(%r1)
    std %r16, 216(%r1)
    std %r17, 224(%r1)
    std %r18, 232(%r1)
    std %r19, 240(%r1)
    std %r20, 248(%r1)
    std %r21, 256(%r1)
    std %r22, 264(%r1)
    std %r23, 272(%r1)
    std %r24, 280(%r1)
    std %r25, 288(%r1)
    std %r26, 296(%r1)
    std %r27, 304(%r1)
    std %r28, 312(%r1)
    std %r29, 320(%r1)
    std %r30, 328(%r1)
    std %r31, 336(%r1)
    
    stfd %f14, 344(%r1)
    stfd %f15, 352(%r1)
    stfd %f16, 360(%r1)
    stfd %f17, 368(%r1)
    stfd %f18, 376(%r1)
    stfd %f19, 384(%r1)
    stfd %f20, 392(%r1)
    stfd %f21, 400(%r1)
    stfd %f22, 408(%r1)
    stfd %f23, 416(%r1)
    stfd %f24, 424(%r1)
    stfd %f25, 432(%r1)
    stfd %f26, 440(%r1)
    stfd %f27, 448(%r1)
    stfd %f28, 456(%r1)
    stfd %f29, 464(%r1)
    stfd %f30, 472(%r1)
    stfd %f31, 480(%r1)

    // r15 = unmanaged target  (pinned at body entry, before mflr/std lr above)
    // Save VASigCookie (r11) into r14 for preservation across the bl below.
    mr      %r14, %r11             // r14 = VASigCookie* (save for restore after call)

    // Prepare arguments for GenericPInvokeCalliStubWorker:
    //   r3 = pTransitionBlock  (pointer to our frame's register save area, == r1 here)
    //   r4 = pVASigCookie      (r11, now in r14)
    //   r5 = pUnmanagedTarget  (r0 target, now in r15)
    mr      %r3, %r1               // arg1: pTransitionBlock
    mr      %r4, %r14              // arg2: pVASigCookie
    mr      %r5, %r15              // arg3: pUnmanagedTarget

    bl      C_FUNC(GenericPInvokeCalliStubWorker)
    nop

    // Restore VASigCookie and unmanaged target from callee-saved registers.
    mr      %r11, %r14             // r11 = VASigCookie* (REG_PINVOKE_COOKIE_PARAM)
    mr      %r0, %r15              // r0  = unmanaged target (for GenericPInvokeCalliHelper hot path)

    // Epilogue: restore all saved registers.
    ld %r3, 32(%r1)
    ld %r4, 40(%r1)
    ld %r5, 48(%r1)
    ld %r6, 56(%r1)
    ld %r7, 64(%r1)
    ld %r8, 72(%r1)
    ld %r9, 80(%r1)
    ld %r10, 88(%r1)

    lfd %f1, 96(%r1)
    lfd %f2, 104(%r1)
    lfd %f3, 112(%r1)
    lfd %f4, 120(%r1)
    lfd %f5, 128(%r1)
    lfd %f6, 136(%r1)
    lfd %f7, 144(%r1)
    lfd %f8, 152(%r1)
    lfd %f9, 160(%r1)
    lfd %f10, 168(%r1)
    lfd %f11, 176(%r1)
    lfd %f12, 184(%r1)
    lfd %f13, 192(%r1)

    ld %r14, 200(%r1)
    ld %r15, 208(%r1)
    ld %r16, 216(%r1)
    ld %r17, 224(%r1)
    ld %r18, 232(%r1)
    ld %r19, 240(%r1)
    ld %r20, 248(%r1)
    ld %r21, 256(%r1)
    ld %r22, 264(%r1)
    ld %r23, 272(%r1)
    ld %r24, 280(%r1)
    ld %r25, 288(%r1)
    ld %r26, 296(%r1)
    ld %r27, 304(%r1)
    ld %r28, 312(%r1)
    ld %r29, 320(%r1)
    ld %r30, 328(%r1)
    ld %r31, 336(%r1)
    
    lfd %f14, 344(%r1)
    lfd %f15, 352(%r1)
    lfd %f16, 360(%r1)
    lfd %f17, 368(%r1)
    lfd %f18, 376(%r1)
    lfd %f19, 384(%r1)
    lfd %f20, 392(%r1)
    lfd %f21, 400(%r1)
    lfd %f22, 408(%r1)
    lfd %f23, 416(%r1)
    lfd %f24, 424(%r1)
    lfd %f25, 432(%r1)
    lfd %f26, 440(%r1)
    lfd %f27, 448(%r1)
    lfd %f28, 456(%r1)
    lfd %f29, 464(%r1)
    lfd %f30, 472(%r1)
    lfd %f31, 480(%r1)

    addi %r1, %r1, 496
    .cfi_def_cfa %r1, 0
    ld %r12, 16(%r1)
    ld %r2, 24(%r1)
    mtlr %r12
    ld %r31, -8(%r1)

    // Tail call back to GenericPInvokeCalliHelper (hot path: pNDirectILStub now != NULL).
    // r0  = unmanaged target (restored above)
    // r11 = VASigCookie*     (restored above)
    b       C_FUNC(GenericPInvokeCalliHelper)
NESTED_END GenericPInvokeCalliGenILStub, _TEXT

LEAF_ENTRY VarargPInvokeStub, _TEXT
// NOT YET IMPLEMENTED
    bl abort 
    nop
LEAF_END VarargPInvokeStub, _TEXT

LEAF_ENTRY VarargPInvokeStub_RetBuffArg, _TEXT
// NOT YET IMPLEMENTED
    bl abort 
    nop
LEAF_END VarargPInvokeStub_RetBuffArg, _TEXT

LEAF_ENTRY VarargPInvokeStubHelper, _TEXT
// NOT YET IMPLEMENTED
    bl abort 
    nop
LEAF_END VarargPInvokeStubHelper, _TEXT

//
// IN: METHODDESC_REGISTER (r11) stub secret param
//     PINVOKE_CALLI_SIGTOKEN_REGISTER (r11) VASigCookie*
//
// ASSUMES: we already checked for an existing stub to use
//
NESTED_ENTRY VarargPInvokeGenILStub, _TEXT, NoHandler
// NOT YET IMPLEMENTED
    bl abort 
    nop
NESTED_END VarargPInvokeGenILStub, _TEXT

//
// IN:
// InlinedCallFrame (rdi) = pointer to the InlinedCallFrame data, including the GS cookie slot (GS cookie right
//                          before actual InlinedCallFrame data)
//
//
NESTED_ENTRY JIT_PInvokeBegin, _TEXT, NoHandler
// NOT YET IMPLEMENTED
    bl abort 
    nop
NESTED_END JIT_PInvokeBegin, _TEXT

//
// IN:
// InlinedCallFrame (rdi) = pointer to the InlinedCallFrame data, including the GS cookie slot (GS cookie right
//                          before actual InlinedCallFrame data)
//
//
LEAF_ENTRY JIT_PInvokeEnd, _TEXT
// NOT YET IMPLEMENTED
    bl abort 
    nop
LEAF_END JIT_PInvokeEnd, _TEXT
