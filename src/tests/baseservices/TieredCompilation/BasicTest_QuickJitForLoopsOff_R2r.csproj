<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>

    <!-- This is an explicit crossgen test -->
    <AlwaysUseCrossGen2>true</AlwaysUseCrossGen2>

    <!-- Crossgen2 is not supported on ppc64le -->
    <CLRTestTargetUnsupported Condition="'$(TargetArchitecture)' == 'ppc64le'">true</CLRTestTargetUnsupported>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BasicTest.cs" />

    <CLRTestEnvironmentVariable Include="DOTNET_TC_QuickJitForLoops" Value="0" />
  </ItemGroup>
</Project>
